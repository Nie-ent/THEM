{
  "name": "them",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @them/game dev",
    "build": "pnpm --filter @them/game build && pnpm build:go",
    "build:go": "cd services && go build -o bin/ ./...",
    "lint": "eslint . --max-warnings 0 && pnpm lint:go",
    "lint:go": "cd services && go vet ./... && test -z \"$(gofmt -l .)\"",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p packages/ui-tokens && tsc -p . && tsc -p tests",
    "test": "vitest run && pnpm test:go",
    "test:go": "cd services && go test ./...",
    "e2e": "playwright test",
    "bench": "tsx packages/core/bench/bench.ts",
    "balance": "tsx tests/balance/run.ts",
    "balance:progression": "tsx tests/balance/progression.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
